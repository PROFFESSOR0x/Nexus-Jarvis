# ── NEXUS example config ──────────────────────────────
# Copy to .env and edit:  copy .env.example .env   (Windows)
#                         cp .env.example .env      (Linux/macOS)

# --- Provider: "ollama" or "openai" ---
LLM_PROVIDER=ollama

# --- OpenAI-compatible (only needed when LLM_PROVIDER=openai) ---
#LLM_MODEL=gpt-4o
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (only needed when LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=qwen:14b
OLLAMA_HOST=http://localhost:11434

# --- Generation ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
THINK_EFFORT=medium

# --- Budgets ---
MAX_ITERATIONS=100
MAX_SUBAGENTS=100
SUBAGENT_MAX_ITERATIONS=100
DELEGATE_MAX_ROUNDS=100

# --- Web deck ---
WEB_HOST=127.0.0.1
WEB_PORT=8777
